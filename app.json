{
  "expo": {
    "name": "RUNEX Driver",
    "slug": "runex-driver",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "runex-driver",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0A0E1A"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/brand/icon.png",
      "bundleIdentifier": "tn.runex.driver"
    },
    "android": {
      "package": "tn.runex.driver",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundImage": "./assets/brand/adaptive-background.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#0E0F12"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/brand/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "RUNEX Driver utilise la caméra pour scanner le QR code et le code-barres des bons de livraison.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo/notification-icon.png",
          "color": "#E31E2B",
          "defaultChannel": "runex-alerts",
          "sounds": ["./assets/sounds/runex_alert.wav"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0F12",
          "image": "./assets/brand/splash-mark.png",
          "imageWidth": 172,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5d6c4e6-3d23-4958-8928-53dd741255cb"
      }
    }
  }
}
