# Copier en .env.local (ignoré par git).
#
# URL de l'API RUNEX. Sans cette variable, en développement, l'application vise
# l'API sur la machine qui sert Metro (même IP, port 4000) — pratique avec un
# téléphone sur le même Wi-Fi. En production : l'URL HTTPS publique.
# EXPO_PUBLIC_API_URL=https://api.runex.tn/api/v1

# Données de démonstration, sans API (true / false). Par défaut : API réelle.
# EXPO_PUBLIC_USE_MOCKS=true
